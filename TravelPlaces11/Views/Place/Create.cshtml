@model CreatePlaceViewModel
@{
    ViewData["Title"] = "Ново място";
}

<h1>Ново място за посещение</h1>

<form asp-controller="Place" asp-action="Create" method="post" class="col-md-8 col-lg-6">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="mb-3">
        <label asp-for="Name" class="form-label"></label> <span class="text-danger">*</span>
        <input asp-for="Name" class="form-control" placeholder="напр. Рилски манастир" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="AreaId" class="form-label"></label> <span class="text-danger">*</span>
        <select asp-for="AreaId" asp-items="Model.Areas" class="form-select">
            <option value="">-- изберете област --</option>
        </select>
        <span asp-validation-for="AreaId" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="PlaceTypeId" class="form-label"></label> <span class="text-danger">*</span>
        <select asp-for="PlaceTypeId" asp-items="Model.PlaceTypes" class="form-select">
            <option value="">-- изберете вид --</option>
        </select>
        <span asp-validation-for="PlaceTypeId" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Fee" class="form-label"></label> <span class="text-danger">*</span>
        <input asp-for="Fee" class="form-control" placeholder="напр. 10.50" />
        <span asp-validation-for="Fee" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Description" class="form-label"></label>
        <textarea asp-for="Description" class="form-control" rows="4"></textarea>
        <span asp-validation-for="Description" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Запази</button>
    <a asp-controller="Place" asp-action="Index" class="btn btn-secondary">Отказ</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
