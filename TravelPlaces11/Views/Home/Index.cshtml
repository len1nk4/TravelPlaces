@{
    ViewData["Title"] = "Начало";
}

<div class="text-center">
    <h1 class="display-4">Места за посещение</h1>
    <p class="lead">
        Туристически обекти в България – търсете по име, филтрирайте по вид
        и споделете впечатленията си с отзив.
    </p>
    <a asp-controller="Place" asp-action="Index" class="btn btn-primary btn-lg me-2">Към местата</a>
    <a asp-controller="Place" asp-action="Create" class="btn btn-outline-primary btn-lg">Добави място</a>
</div>
